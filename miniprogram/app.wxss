page {
  background: #f4efe7;
  color: #2f2925;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.screen {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  padding: 24rpx 0 36rpx;
}

.eyebrow {
  font-size: 24rpx;
  color: #1f6b4f;
  margin-bottom: 12rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #6d6257;
  line-height: 1.6;
}

.panel {
  background: #fffaf4;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(67, 47, 34, 0.08);
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.panel-copy {
  font-size: 24rpx;
  color: #776b5f;
  line-height: 1.6;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #6d6257;
  margin-bottom: 10rpx;
}

.text-input,
.text-area {
  width: 100%;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 1rpx solid #dbcfc3;
  background: #ffffff;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
  color: #2f2925;
  margin-bottom: 18rpx;
}

.text-area {
  min-height: 180rpx;
}

.primary-button,
.secondary-button,
.ghost-button,
.danger-button {
  width: 100%;
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.primary-button {
  background: #1f6b4f;
  color: #fffefb;
}

.secondary-button {
  background: #ef7657;
  color: #fffefb;
}

.ghost-button {
  background: #f4ecdf;
  color: #2f2925;
}

.danger-button {
  background: #b5483d;
  color: #fffefb;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row .ghost-button,
.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.error-text {
  color: #b5483d;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.empty-state {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #7d7268;
  font-size: 26rpx;
  line-height: 1.6;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f1ec;
  color: #1f6b4f;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.muted {
  color: #7d7268;
}
