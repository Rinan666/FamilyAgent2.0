# ============================================
# FamilyAgent .gitignore
# ============================================

# --- Java / Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
.gradle/
build/

# --- Python ---
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv*/
venv/
env/
*.egg

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.next

# --- IDE ---
.idea/
.vscode/
.claude/settings.local.json
*.swp
*.swo
*~
.project
.classpath
.settings/
*.iml
.trae/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Environment ---
.env
.env.docker
.env.backup

# --- Runtime ---
.service-pids.txt
.codex-runtime-pids.txt
/scripts/local_tools/
backups/

# --- Docker ---
docker-compose.override.yml

# --- Logs ---
logs/
*.log

# --- Uploads ---
uploads/
storage/

# --- AI ---
*.gguf
models/
checkpoints/
.claude/

# --- Coverage ---
coverage/
.nyc_output/
jacoco.exec
frontend/output/playwright/
frontend/.npm-cache/

# --- Docs ---
# Project-facing docs stay tracked under docs/product, docs/reference, docs/deployment.
# Academic materials and draft plans stay ignored.
docs/academic/
docs/plans/
docs/**/.claude/
项目类图-精简重构版.md
CLAUDE.md
AGENTS.md
*学习*.md
*讲解.md

# --- DIP homework (datasets + experiment outputs, not production code) ---
dip-homework/
