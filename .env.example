# ============================================
# FamilyAgent shared local environment
# Copy this file to /.env and adjust values for your machine.
# All local services read from the repository-root .env.
# ============================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
UPLOAD_MAX_SIZE_MB=10

# --- Ports & Service URLs ---
BACKEND_URL=http://localhost:8180
AI_SERVICE_PORT=8090
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TIMEOUT=60
SERVER_PORT=8180

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familyagent
DB_USER=fa_user
DB_PASSWORD=fa_dev_pass

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fa_user
RABBITMQ_PASSWORD=fa_dev_pass

# --- MinIO ---
MINIO_PORT=9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
AI_INTERNAL_SERVICE_TOKEN=familyagent-dev-internal-token

# --- AI Models & Keys ---
CLAUDE_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEFAULT_LLM_MODEL=dashscope/qwen-flash
FALLBACK_LLM_MODEL=dashscope/qwen-turbo
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=dashscope-multimodal/qwen3-vl-embedding
EMBEDDING_DIMENSION=1536
DASHSCOPE_MULTIMODAL_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding

# --- AI Runtime ---
STORAGE_DRIVER=minio
AUTH_FAIL_OPEN=
CORS_ALLOW_ORIGINS=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_STREAM_METADATA_TIMEOUT_SECONDS=0.25
TAVILY_API_KEY=
AI_MAX_MESSAGE_CHARS=8000
AI_MAX_TOTAL_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=1800
AI_HARD_TIMEOUT_SECONDS=100
AI_STREAM_IDLE_TIMEOUT_SECONDS=20
AI_GLOBAL_CONCURRENCY=8
AI_USER_CONCURRENCY=2
AI_USER_RATE_LIMIT_PER_MINUTE=20
AI_IP_RATE_LIMIT_PER_MINUTE=60
AI_EMBEDDING_USER_RATE_LIMIT_PER_MINUTE=120
AI_EMBEDDING_IP_RATE_LIMIT_PER_MINUTE=240
AI_EMBEDDING_TIMEOUT_SECONDS=30
MATH_SANDBOX_TIMEOUT=5
MATH_SANDBOX_MAX_MEMORY_MB=256
LOG_LEVEL=DEBUG

# --- Tunnel ---
TUNNEL_ENABLED=true
TUNNEL_PROVIDER=cloudflare
TUNNEL_MODE=named
TUNNEL_CONFIG_PATH=
TUNNEL_PUBLIC_HOST=app.familyagent.cn
TUNNEL_TARGET_URL=http://127.0.0.1:3000
START_TUNNEL=false
