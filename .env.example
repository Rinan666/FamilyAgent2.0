# ============================================
# FamilyAgent 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 数据库 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familyagent
DB_USER=fa_user
DB_PASSWORD=fa_dev_pass

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fa_user
RABBITMQ_PASSWORD=fa_dev_pass

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- JWT ---
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- LLM API Keys ---
CLAUDE_API_KEY=sk-ant-xxx
DEEPSEEK_API_KEY=sk-xxx
OPENAI_API_KEY=sk-xxx
DASHSCOPE_API_KEY=sk-xxx

# --- LLM 配置 ---
DEFAULT_LLM_MODEL=claude-sonnet-4-6
FALLBACK_LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=dashscope-multimodal/tongyi-embedding-vision-flash-2026-03-06
EMBEDDING_DIMENSION=1536
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MULTIMODAL_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding

# --- AI 服务 ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=60
AUTH_FAIL_OPEN=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 应用 ---
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000

# --- 文件存储 ---
UPLOAD_MAX_SIZE_MB=10
STORAGE_DRIVER=minio
