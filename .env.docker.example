# ============================================
# FamilyAgent Docker deployment environment
# Copy to /.env.docker before running the stack.
# ============================================

# --- App ---
APP_ENV=prod
APP_DEBUG=false
APP_URL=https://app.familyagent.cn
UPLOAD_MAX_SIZE_MB=10

# --- Public ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Internal service URLs ---
BACKEND_URL=http://backend:8080
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=60
SERVER_PORT=8080

# --- Database ---
DB_HOST=postgres
DB_NAME=familyagent
DB_USER=fa_user
DB_PASSWORD=fa_dev_pass

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=fa_user
RABBITMQ_PASSWORD=fa_dev_pass

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Auth ---
# Sa-Token uses its own token mechanism (tik mode). Set a strong internal-service token for backend ↔ AI service auth.
AI_INTERNAL_SERVICE_TOKEN=change-me-to-a-random-token-at-least-32-chars

# --- AI Models & Keys ---
CLAUDE_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEFAULT_LLM_MODEL=dashscope/qwen-flash
FALLBACK_LLM_MODEL=dashscope/qwen-turbo
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=dashscope-multimodal/qwen3-vl-embedding
EMBEDDING_DIMENSION=1536
DASHSCOPE_MULTIMODAL_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding

# --- AI Runtime ---
AUTH_FAIL_OPEN=false
CORS_ALLOW_ORIGINS=https://familyagent.cn,https://www.familyagent.cn,https://app.familyagent.cn,https://app.familyagentai.top
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_STREAM_METADATA_TIMEOUT_SECONDS=0.25
TAVILY_API_KEY=
AI_MAX_MESSAGE_CHARS=8000
AI_MAX_TOTAL_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=1800
AI_HARD_TIMEOUT_SECONDS=100
AI_STREAM_IDLE_TIMEOUT_SECONDS=20
AI_GLOBAL_CONCURRENCY=8
AI_USER_CONCURRENCY=2
AI_USER_RATE_LIMIT_PER_MINUTE=20
AI_IP_RATE_LIMIT_PER_MINUTE=60
AI_EMBEDDING_USER_RATE_LIMIT_PER_MINUTE=120
AI_EMBEDDING_IP_RATE_LIMIT_PER_MINUTE=240
AI_EMBEDDING_TIMEOUT_SECONDS=30
MATH_SANDBOX_TIMEOUT=5
MATH_SANDBOX_MAX_MEMORY_MB=256
LOG_LEVEL=INFO

# --- Container tuning ---
DOCKER_POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
DOCKER_REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
DOCKER_RABBITMQ_IMAGE=docker.m.daocloud.io/library/rabbitmq:3.13-management-alpine
DOCKER_MINIO_IMAGE=docker.m.daocloud.io/minio/minio:latest
DOCKER_MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-17
DOCKER_JAVA_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-jammy
DOCKER_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
DOCKER_NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
DOCKER_FRONTEND_BACKEND_URL=http://backend:8080
DOCKER_FRONTEND_AI_SERVICE_URL=http://ai-service:8000
JAVA_OPTS=-Xms256m -Xmx768m
