# Docker Compose infrastructure settings for the production server.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=familyagent
DB_USER=fa_prod
DB_PASSWORD=replace-with-strong-db-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=fa_prod
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password

MINIO_PORT=9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
