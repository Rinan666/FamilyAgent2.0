# FastAPI production environment for FamilyAgent AI service.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.familyagent.cn

AI_SERVICE_PORT=8090
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TIMEOUT=60

BACKEND_URL=http://127.0.0.1:8180
AUTH_FAIL_OPEN=false
CORS_ALLOW_ORIGINS=https://app.familyagent.cn,https://www.familyagent.cn
AI_INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-token

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=familyagent
DB_USER=fa_prod
DB_PASSWORD=replace-with-strong-db-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=fa_prod
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

JWT_SECRET=replace-with-32-plus-char-secret
JWT_EXPIRATION_MS=86400000

CLAUDE_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=replace-with-production-dashscope-key
DEFAULT_LLM_MODEL=dashscope/qwen-flash
FALLBACK_LLM_MODEL=dashscope/qwen-turbo
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=dashscope-multimodal/qwen3-vl-embedding
EMBEDDING_DIMENSION=1536
