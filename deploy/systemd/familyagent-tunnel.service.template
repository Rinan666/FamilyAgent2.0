[Unit]
Description=FamilyAgent Cloudflare named tunnel
After=network-online.target familyagent-frontend.service
Requires=familyagent-frontend.service

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
WorkingDirectory=__APP_ROOT__
ExecStart=/usr/bin/env bash -lc 'exec cloudflared tunnel --config "__ETC_DIR__/cloudflared/config.yml" run'
Restart=always
RestartSec=5
TimeoutStartSec=0

[Install]
WantedBy=familyagent.target
