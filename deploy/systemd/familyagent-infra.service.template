[Unit]
Description=FamilyAgent infrastructure containers
Wants=network-online.target
After=network-online.target
Before=familyagent-ai.service familyagent-backend.service familyagent-frontend.service familyagent-tunnel.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__APP_ROOT__
ExecStart=/usr/bin/env bash -lc 'docker compose --env-file "__ETC_DIR__/infra.env" -f "__APP_ROOT__/docker-compose.yml" up -d'
ExecStop=/usr/bin/env bash -lc 'docker compose --env-file "__ETC_DIR__/infra.env" -f "__APP_ROOT__/docker-compose.yml" stop'
TimeoutStartSec=0

[Install]
WantedBy=familyagent.target
