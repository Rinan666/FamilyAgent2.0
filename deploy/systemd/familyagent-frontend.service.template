[Unit]
Description=FamilyAgent frontend service
After=network-online.target familyagent-backend.service familyagent-ai.service

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
WorkingDirectory=__APP_ROOT__/frontend
EnvironmentFile=__ETC_DIR__/frontend.env
ExecStart=/usr/bin/env bash -lc 'exec npm run start -- --hostname 0.0.0.0 --port "${FRONTEND_PORT:-3000}"'
Restart=always
RestartSec=5
TimeoutStartSec=0

[Install]
WantedBy=familyagent.target
