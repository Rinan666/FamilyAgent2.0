# ============================================
# FamilyAgent infrastructure environment variables example
# Root-level config is only for local infra used by docker compose.
# App/service-specific config lives in frontend/.env.local and ai-service/.env.
# ============================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familyagent
DB_USER=fa_user
DB_PASSWORD=fa_dev_pass

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fa_user
RABBITMQ_PASSWORD=fa_dev_pass

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Keep this file infra-only to avoid implying a single global config source.
