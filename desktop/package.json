{
  "name": "familyagent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "FamilyAgent Windows desktop launcher",
  "author": "FamilyAgent",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "check": "node --check src/main.js",
    "stage": "node scripts/stage-stack.js",
    "pack": "npm run stage && electron-builder --dir",
    "dist:win": "npm run stage && electron-builder --win nsis"
  },
  "build": {
    "appId": "cn.familyagent.desktop",
    "productName": "FamilyAgent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".stack",
        "to": "familyagent-stack",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12"
  }
}
